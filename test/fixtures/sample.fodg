<?xml version="1.0" encoding="UTF-8"?>
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.graphics">
  <office:automatic-styles>
    <style:style style:name="fill" style:family="graphic">
      <style:graphic-properties draw:fill="solid" draw:fill-color="#3465a4" draw:stroke="solid" svg:stroke-color="#1c3f6e"/>
    </style:style>
    <style:style style:name="label" style:family="graphic">
      <style:graphic-properties draw:fill="none" draw:stroke="none"/>
      <style:text-properties fo:font-size="18pt"/>
    </style:style>
  </office:automatic-styles>
  <office:body>
    <office:drawing>
      <draw:page draw:name="page1">
        <draw:rect draw:style-name="fill" svg:x="2cm" svg:y="2cm" svg:width="8cm" svg:height="5cm"/>
        <draw:ellipse draw:style-name="fill" svg:x="12cm" svg:y="2cm" svg:width="6cm" svg:height="5cm"/>
        <draw:frame draw:style-name="label" svg:x="2cm" svg:y="8cm" svg:width="16cm" svg:height="2cm">
          <draw:text-box>
            <text:p>Sample drawing</text:p>
          </draw:text-box>
        </draw:frame>
      </draw:page>
    </office:drawing>
  </office:body>
</office:document>
